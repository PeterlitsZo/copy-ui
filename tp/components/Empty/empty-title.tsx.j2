import classNames from "classnames";
import type { ComponentProps, FC } from "react";

import styles from "./empty-title.module.scss";

type EmptyTitleProps = ComponentProps<"div">;

const EmptyTitle: FC<EmptyTitleProps> = (props) => {
  const { children, className, ...rest } = props;

  return (
    <div className={classNames(styles.emptyTitle, className)} {...rest}>
      {children}
    </div>
  );
};

EmptyTitle.displayName = "Empty.Title";

export { EmptyTitle };
