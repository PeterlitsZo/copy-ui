import classNames from "classnames";
import type { ComponentProps, FC } from "react";

import styles from "./empty.module.scss";
import { EmptyContentFlex } from "./empty-content";
import { EmptyDescription } from "./empty-description";
import { EmptyHeader } from "./empty-header";
import { EmptyMedia } from "./empty-media";
import { EmptyTitle } from "./empty-title";

type EmptyProps = ComponentProps<"div">;

type EmptyComponent = FC<EmptyProps> & {
  Header: typeof EmptyHeader;
  Media: typeof EmptyMedia;
  Title: typeof EmptyTitle;
  Description: typeof EmptyDescription;
  ContentFlex: typeof EmptyContentFlex;
};

const Empty: EmptyComponent = (props: EmptyProps) => {
  const { className, children, ...rest } = props;

  return (
    <div className={classNames(styles.empty, className)} {...rest}>
      {children}
    </div>
  );
};

Empty.displayName = "Empty";

Empty.Header = EmptyHeader;
Empty.Media = EmptyMedia;
Empty.Title = EmptyTitle;
Empty.Description = EmptyDescription;
Empty.ContentFlex = EmptyContentFlex;

export { Empty };
