import classNames from "classnames";
import type { ComponentProps, FC } from "react";

import { useJss, useTheme } from "@/components/CopyUiProvider";

import styles from "./empty-media.module.scss";

type EmptyMediaProps = ComponentProps<"div">;

const EmptyMedia: FC<EmptyMediaProps> = (props) => {
  const { children, className, ...rest } = props;

  const jss = useJss();
  const theme = useTheme();

  const stx = jss.hash({
    "--emptyMedia-color": theme.colors.gray["800"],
    "--emptyMedia-bgColor": theme.colors.gray["100"],
    "--emptyMedia-bdRadius": "0.375rem",
  });

  return (
    <div className={classNames(styles.emptyMedia, stx, className)} {...rest}>
      {children}
    </div>
  );
};

EmptyMedia.displayName = "Empty.Media";

export { EmptyMedia };
