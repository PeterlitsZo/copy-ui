@layer components {
  .popoverMenuItem {
    list-style: none;
  }

  .popoverMenuItemButton {
    display: flex;
    align-items: center;
    text-align: start;
    width: 100%;
    padding: 0.25rem 0.5rem;
    border: none;
    border-radius: calc(var(--popover-menu-border-radius) * 0.5);
    background: transparent;
    cursor: pointer;
    user-select: none;
    font-size: inherit;
    line-height: inherit;
    color: inherit;

    &:hover:not([data-disabled="true"]) {
      background-color: var(--popover-menu-item-hover-bg-color);
    }

    &[data-disabled="true"] {
      cursor: not-allowed;
      color: var(--popover-menu-item-disabled-color);
    }

    &:focus-visible {
      outline: 2px solid var(--popover-menu-focus-outline-color, currentColor);
      outline-offset: -2px;
    }
  }

  .popoverMenuItemContent {
    flex: 1;
  }
}

