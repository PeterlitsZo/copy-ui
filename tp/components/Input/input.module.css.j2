@layer components {
  .ibsBase {
    border-color: var(--input-bdColor, var(--ibsBase-bdColor));

    &:has(.input:focus) {
      outline: none;
      border-color: var(--input-focus-bdColor);
    }
  }

  .input {
    align-self: stretch;
    flex: 1;

    padding-inline-start: var(--input-pl);
    padding-inline-end: var(--input-pr);
    caret-color: var(--input-caretColor);

    outline: none;
    border: none;

    font-size: var(--input-fontSize);
    line-height: var(--input-lineHeight);

    &::placeholder {
      color: var(--input-placeholderColor);
    }

    [data-disabled="true"] & {
      pointer-events: none;
      cursor: inherit;
    }
  }
}
