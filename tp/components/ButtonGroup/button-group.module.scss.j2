@layer components {
  .buttonGroup {
    display: flex;

    & > *:not(:only-child):first-child {
      border-end-end-radius: 0;
      border-start-end-radius: 0;
      border-inline-end-width: calc(var(--button-bdWidth) / 2);
      border-inline-end-color: var(--button-separatorBdColor, var(--button-bdColor));
    }

    & > *:not(:only-child):not(:first-child):not(:last-child) {
      border-radius: 0;
      border-inline-start-width: calc(var(--button-bdWidth) / 2);
      border-inline-end-width: calc(var(--button-bdWidth) / 2);
      border-inline-start-color: var(--button-separatorBdColor, var(--button-bdColor));
      border-inline-end-color: var(--button-separatorBdColor, var(--button-bdColor));
    }

    & > *:not(:only-child):last-child {
      border-start-start-radius: 0;
      border-end-start-radius: 0;
      border-inline-start-width: calc(var(--button-bdWidth) / 2);
      border-inline-start-color: var(--button-separatorBdColor, var(--button-bdColor));
    }
  }
}
