import { createContext, useContext } from "react";
import type { StoreApi } from "zustand";

import type { AvatarStore } from "./avatar-store";

const AvatarContext = createContext<StoreApi<AvatarStore> | null>(null);

const useAvatarStore = () => {
  const context = useContext(AvatarContext);
  if (!context) {
    throw new Error("useAvatarStore must be used within a Avatar");
  }
  return context;
};

export { AvatarContext, useAvatarStore };
