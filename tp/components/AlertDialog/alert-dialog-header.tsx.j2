import classNames from "classnames";
import type { ComponentProps, FC } from "react";

import { Card } from "@/components/Card";

import styles from "./alert-dialog.module.scss";

type AlertDialogHeaderProps = ComponentProps<typeof Card.Header>;

const AlertDialogHeader: FC<AlertDialogHeaderProps> = (props) => {
  const { className, ...rest } = props;

  return (
    <Card.Header className={classNames(styles.header, className)} {...rest} />
  );
};

AlertDialogHeader.displayName = "AlertDialog.Header";

export { AlertDialogHeader };
