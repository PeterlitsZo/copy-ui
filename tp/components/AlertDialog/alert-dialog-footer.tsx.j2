import classNames from "classnames";
import type { ComponentProps, FC } from "react";

import { Card } from "@/components/Card";

import styles from "./alert-dialog-footer.module.scss";

type AlertDialogFooterProps = ComponentProps<typeof Card.Footer>;

const AlertDialogFooter: FC<AlertDialogFooterProps> = (props) => {
  const { className, ...rest } = props;

  return (
    <Card.Footer
      className={classNames(styles.alertDialogFooter, className)}
      {...rest}
    />
  );
};

AlertDialogFooter.displayName = "AlertDialog.Footer";

export { AlertDialogFooter };
