@layer components {
  .selectListContainer {
    width: var(--selectList-w);
    border-width: 1px;
    border-style: solid;
    border-color: var(--selectList-bdColor);
    border-radius: var(--selectList-bdRadius);
    background-color: white;
  }

  .selectList {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: var(--selectList-p);
    font-size: var(--selectList-fontSize);
    line-height: var(--selectList-lineHeight);
  }

  .selectItem button {
    display: flex;
    align-items: center;

    text-align: start;

    width: 100%;
    padding: 0.25rem var(--selectItem-px);

    border-radius: calc(var(--selectList-bdRadius) * 0.5);

    cursor: pointer;
    user-select: none;

    &:hover {
      background-color: var(--selectItem-hover-bgColor);
    }

    > span {
      flex: 1;
    }

    > svg {
      width: 1rem;
      height: 1rem;
      color: var(--selectItem-markColor);
    }
  }

  .emptyState {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    gap: 0.25rem;
    color: var(--emptyState-color);

    .emptyStateIcon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      color: var(--emptyStateIcon-color);
      background-color: var(--emptyStateIcon-bgColor);
      border-radius: 0.375rem;
    }
  }
}