import classNames from "classnames";
import type { ComponentProps, FC } from "react";

import styles from "./ibs-base-wrapper.module.scss";

type IbsBaseWrapperProps = ComponentProps<"div">;

const IbsBaseWrapper: FC<IbsBaseWrapperProps> = (props) => {
  const { className, children, ...rest } = props;

  return (
    <div className={classNames(styles.ibsBaseWrapper, className)} {...rest}>
      {children}
    </div>
  );
};

IbsBaseWrapper.displayName = "IbsBase.Wrapper";

export { IbsBaseWrapper };
